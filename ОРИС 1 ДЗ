class PlayList: 
    def __init__(self):
        self.songs = []

    def add_song(self, song, duration):
        song_data = {
            "name": song,
            "duration": duration
        }

        self.songs.append(song_data)

    def remove_song(self, name):
        for song in self.songs:
            if name == song["name"]:
                self.songs.remove(song)

    def total_duration(self):
        Summ = 0
        for song in self.songs:
            Summ = Summ + song["duration"]
        return Summ
        
    def __len__(self):
        return len(self.songs)

    def show_songs (self):
        print( self.songs )



