def is_positive(number):
    """Функци возвращает True если число положительное 

    Args:
        number: список положительных чисел

    Returns:
        int: вывод True or False
"""
    if number > 0:
        return True
    else:
        return False


def sum_positive(numbers):
    """Функци считает сумму положительных чисел используя функция is_positive  

    Args:
        numbers: сумма положительных чисел

    Returns:
        int: вывод суммы положительных чисел
"""
    sum_positive1 = 0
    for num in numbers:
        if is_positive(num):
            sum_positive1 = sum_positive1 + num
    return sum_positive1


def count_positive(numbers):
    """Функци считает колличество положительных чисел используя функция is_positive  

    Args:
        numbers: колличество положительных чисел

    Returns:
        int: вывод колличества положительных чисел
"""
    count = 0
    for num in numbers:
        if is_positive(num):
            count = count + 1
    return count


positive_sum = sum_positive(numbers)
positive_count = count_positive(numbers)

print("Сумма положительных:", positive_sum)
print("Количество положительных:", positive_count)
